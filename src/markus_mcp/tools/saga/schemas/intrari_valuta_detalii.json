    {"name": "TVA_ART", "aliases": ["tva_art", "tva_proc", "TVAProc", "vat_rate"], "kind": "number", "description": "VAT rate %"},
    {"name": "ValoareValuta", "aliases": ["valoare_valuta"], "kind": "number", "description": "Line amount FX"},
    {"name": "Cont", "aliases": ["cont", "account"], "kind": "combo", "selectModel": "Conturi", "description": "Expense/stock account", "required": true},
    {"name": "Gestiune", "aliases": ["gestiune", "warehouse"], "kind": "combo", "selectModel": "Gestiuni", "description": "Warehouse"},
    {"name": "Cod", "aliases": ["cod", "sku"], "kind": "text", "description": "Article code"},
    {"name": "ID_Intrare", "kind": "text", "description": "Parent invoice id", "expose": false},
    {"name": "ID_IntrareDet", "kind": "text", "description": "Line id", "expose": false},
    {"name": "Id", "kind": "text", "description": "Classic RowData Id", "expose": false}
  ]
}
