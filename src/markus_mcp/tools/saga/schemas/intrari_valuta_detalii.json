    "create": ["IntrariValuta/Create_IntrariValutaDetalii", "IntrariValutaDetalii/Create_IntrariValutaDetalii"]
  },
  "usage": "Required per line: Cont, and amounts (Cantitate + PretUnitarValuta, or explicit totals).",
  "columns": [
    {"name": "Denumire", "aliases": ["denumire", "descriere", "Descriere", "item_name"], "kind": "text", "description": "Article/service name"},
