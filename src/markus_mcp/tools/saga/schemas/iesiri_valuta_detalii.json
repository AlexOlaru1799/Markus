{
  "operation": "iesiri_valuta_detalii",
  "table": "IesiriValutaDetalii",
  "controller": "IesiriValuta",
  "primary_key": "ID_IesireDet",
  "route": "IesiriValuta",
  "write_style": "classic",
  "risk": "medium",
  "is_detail": true,
  "master_table": "IesiriValuta",
  "selection_key": "ID_Iesire",
  "actions": {
    "get_data": ["IesiriValuta/GetData_IesiriValutaDetalii", "IesiriValutaDetalii/GetData_IesiriValutaDetalii"],
    "create": ["IesiriValuta/Create_IesiriValutaDetalii", "IesiriValutaDetalii/Create_IesiriValutaDetalii"],
    "delete": ["IesiriValuta/Delete_IesiriValutaDetalii", "IesiriValutaDetalii/Delete_IesiriValutaDetalii"]
  },
  "usage": "Required per line: Cont, and amounts (Cantitate + PretUnitarValuta, or explicit totals). Also useful: Denumire, Cod_Art/Cod, UM, TVA_ART, Gestiune.",
  "columns": [
    {"name": "Tip", "aliases": ["tip", "tip_articol", "item_type"], "kind": "combo", "selectModel": "TipArticol", "description": "Item type"},
    {"name": "Cod_Art", "aliases": ["cod_art", "cod_articol", "article_code", "sku"], "kind": "text", "description": "Article/service code"},
    {"name": "Cod", "aliases": ["cod"], "kind": "text", "description": "Article/service code (line Cod column)"},
    {"name": "Denumire", "aliases": ["denumire", "denumire_articol", "item_name", "description"], "kind": "text", "description": "Article/service name"},
    {"name": "Gestiune", "aliases": ["gestiune", "warehouse"], "kind": "combo", "selectModel": "Gestiuni", "description": "Warehouse"},
    {"name": "CodGestiune", "aliases": ["cod_gestiune", "warehouse_code"], "kind": "text", "description": "Warehouse code"},
    {"name": "Cont", "aliases": ["cont", "account", "cont_articol"], "kind": "combo", "selectModel": "Conturi", "description": "Revenue account (required by SAGA, e.g. 704 / 707)", "required": true},
    {"name": "Cantitate", "aliases": ["cantitate", "qty", "quantity"], "kind": "number", "description": "Quantity"},
    {"name": "UM", "aliases": ["um", "unit"], "kind": "text", "description": "Unit of measure"},
    {"name": "PretUnitarValuta", "aliases": ["pret_unitar_valuta", "unit_price_fx", "price_fx", "pret_valuta"], "kind": "number", "description": "Unit price in foreign currency"},
    {"name": "PretUnitar", "aliases": ["pret_unitar", "unit_price_ron", "price_ron"], "kind": "number", "description": "Unit price in RON (auto from PretUnitarValuta * Curs when omitted)"},
    {"name": "TVA_ART", "aliases": ["tva_art", "tva", "vat_rate"], "kind": "number", "description": "VAT rate % (use rates valid for Data — e.g. 0/11/21 from Aug 2025)"},
    {"name": "ValoareValuta", "aliases": ["valoare_valuta", "line_total_fx"], "kind": "number", "description": "Line amount FX (usually calculated)"},
    {"name": "TVAValuta", "aliases": ["tva_valuta", "vat_fx"], "kind": "number", "description": "VAT amount FX (usually calculated)"},
    {"name": "TotalValuta", "aliases": ["total_valuta", "line_total_fx_with_vat"], "kind": "number", "description": "Line total FX with VAT (usually calculated)"},
    {"name": "Activitate", "aliases": ["activitate"], "kind": "text", "description": "Activity / cost center"},
    {"name": "InformatiiSuplimentare", "aliases": ["informatii_suplimentare", "inf_supl", "item_notes"], "kind": "text", "description": "Line notes"},
    {"name": "ID_U", "aliases": ["id_u"], "kind": "text", "description": "Internal line uid (optional)"},
    {"name": "ID_Iesire", "kind": "text", "description": "Parent invoice id", "expose": false},
    {"name": "ID_IesireDet", "kind": "text", "description": "Line id", "expose": false},
    {"name": "Id", "kind": "text", "description": "Classic RowData Id", "expose": false},
    {"name": "Valoare", "kind": "number", "description": "Line amount RON", "expose": false},
    {"name": "TVA", "kind": "number", "description": "Line VAT RON", "expose": false},
    {"name": "Adaos", "kind": "number", "description": "Markup", "expose": false}
  ]
}
