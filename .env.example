# Optional overrides for local stdio runs (defaults use ~/.markus).
# MARKUS_MCP_TRANSPORT=stdio
# MARKUS_HOME=/Users/YOU/.markus
# MARKUS_DATA_DIR=/Users/YOU/.markus/data
# SAGA_CREDENTIALS_FILE=/Users/YOU/.markus/private.data
WHATSAPP_HEADLESS=true
WHATSAPP_PAIR_TIMEOUT_SEC=180
WHATSAPP_QR_REFRESH_INTERVAL_SEC=15
SAGA_BASE_URL=https://web.sagasoft.ro
SAGA_HEADLESS=true
# Optional: better PDF invoice field extraction (otherwise heuristics only)
# MARKUS_LLM_API_KEY=
# MARKUS_LLM_BASE_URL=https://api.openai.com/v1
# MARKUS_LLM_MODEL=gpt-4o-mini
